#include <windows.h>

1 ICON "DriveScanner.ico"
1 RT_MANIFEST "DriveScanner.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Jayson Brush"
            VALUE "FileDescription", "DriveScanner - disk usage viewer"
            VALUE "LegalCopyright", "Copyright (c) 2026 Jayson Brush. MIT License."
            VALUE "FileVersion", "1.0.0"
            VALUE "ProductName", "DriveScanner"
            VALUE "ProductVersion", "1.0.0"
            VALUE "OriginalFilename", "DriveScanner.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
